# Beampipe v2 source-tree fallback. Copy to .env; never commit .env.

# Core image and control plane.
BEAMPIPE_VERSION=0.1.6
BEAMPIPE_PULL_POLICY=missing
BEAMPIPE_ENV=development
BEAMPIPE_JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgres://postgres:postgres@localhost:5432/beampipe
BEAMPIPE_CONFIG=beampipe.yaml
BEAMPIPE_CORS_ALLOW_ORIGINS=
BEAMPIPE_METRICS_PUBLIC=false

# Redis-backed rate limiting is mandatory in production.
BEAMPIPE_REDIS_URL=
BEAMPIPE_REQUIRE_RATE_LIMITER=false
BEAMPIPE_RATE_LIMIT_REQUESTS=10
BEAMPIPE_RATE_LIMIT_PERIOD_SECONDS=3600
BEAMPIPE_TRUSTED_PROXY_CIDRS=

# External providers are opt-in. Project samples and deployment profiles add
# only the staging/deployment capabilities they require.
BEAMPIPE_USE_REAL_BACKENDS=false
BEAMPIPE_BACKEND_CAPABILITIES=
BEAMPIPE_METRICS_LIVE_SLURM_PROBE_ENABLED=false
BEAMPIPE_TM_URL=http://127.0.0.1:9000
BEAMPIPE_DIM_URL=http://127.0.0.1:8001

# Neutral worker capabilities contain no staging or deployment provider.
BEAMPIPE_WORKER_POOL=default
BEAMPIPE_WORKER_CAPABILITIES=discovery:tap,manifest:generic,translation:daliuge,verification:output_inventory
BEAMPIPE_WORKER_CONCURRENCY=4
BEAMPIPE_WORKER_SCHEDULER_ENABLED=false
BEAMPIPE_WORKER_LOCK_SECONDS=600
BEAMPIPE_WORKER_SUBMISSION_TIMEOUT_SECONDS=1800

# Bound external dependency probes.
BEAMPIPE_DISCOVERY_TAP_HEALTH_CACHE_SECONDS=30
BEAMPIPE_METRICS_TAP_HEALTH_REFRESH_SECONDS=300

# Generic SSH credential store. It is read only when a Slurm capability and
# matching profile are explicitly selected.
BEAMPIPE_SSH_CREDENTIALS_HOST=./deploy/ssh/credentials
BEAMPIPE_SSH_CREDENTIALS_DIR=
BEAMPIPE_SLURM_SSH_STRICT_KNOWN_HOSTS=true
BEAMPIPE_ALLOW_INSECURE_SSH_HOST_KEYS=false
BEAMPIPE_SLURM_SSH_ALLOW_HOME_FALLBACK=false
BEAMPIPE_ALLOW_INLINE_SECRETS=false

# Production Compose database values.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=beampipe
