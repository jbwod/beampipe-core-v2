{
  "name": "slurm-remote",
  "description": "WALLABY HiRes on Setonix via slurm_remote",
  "project_module": "wallaby_hires",
  "is_default": false,
  "translation": {
    "algo": "metis",
    "num_par": 1,
    "num_islands": 1,
    "tm_url": "http://dlg-tm.desk"
  },
  "deployment": {
    "kind": "slurm_remote",
    "login_node": "setonix.pawsey.org.au",
    "ssh_port": 22,
    "remote_user": "jblackwood",
    "ssh_credential": "setonix",
    "facility": "setonix",
    "account": "pawsey0411",
    "home_dir": "/scratch/pawsey0411",
    "dlg_root": "/scratch/pawsey0411/jblackwood/dlg",
    "log_dir": "/scratch/pawsey0411/jblackwood/dlg/log",
    "modules": "module load singularity/4.1.0-askap && module load py-numpy/1.26.4 && module use /group/askap/modulefiles",
    "venv": "source /software/projects/pawsey0411/jblackwood/venv/bin/activate",
    "runtime_contract": {
      "required_commands": ["wallaby_hires", "singularity"],
      "required_python_modules": ["wallaby_hires", "beampipe_pallette.apps"],
      "required_environment": [
        {
          "name": "BEAMPIPE_ASKAPSOFT_SIF",
          "kind": "readable_file"
        }
      ],
      "output_subdirectory": "wallaby_outputs",
      "shared_staging_subdirectory": "wallaby_staging_data",
      "output_environment_variable": "WALLABY_HIRES_STAGING_ROOT",
      "shared_staging_environment_variable": "WALLABY_HIRES_CACHE_ROOT"
    },
    "publication": {
      "durable_destination_uri_environment": "BEAMPIPE_OUTPUT_DESTINATION_URI"
    },
    "exec_prefix": "srun -l",
    "job_duration_minutes": 120,
    "num_nodes": 1,
    "num_islands": 1,
    "resources": {
      "partition": "work",
      "nodes": 1,
      "tasks": 1,
      "cpus_per_task": 1,
      "wall_time_minutes": 120
    },
    "manager_topology": {
      "islands": 1
    },
    "max_threads": 0,
    "verbose_level": 1,
    "all_nics": false,
    "verify_ssl": false
  }
}
