# Written by `beampipe setup` / `beampipe init`. Copy is created as .env.
# Bump with the Cargo.toml workspace version and docker-compose :-default.

BEAMPIPE_VERSION=0.1.5
BEAMPIPE_PULL_POLICY=missing

BEAMPIPE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/beampipe
BEAMPIPE_DATABASE_URL_DOCKER=postgres://postgres:postgres@postgres:5432/beampipe
BEAMPIPE_POSTGRES_PASSWORD=replace-with-a-random-database-password
BEAMPIPE_POSTGRES_PORT=5432
BEAMPIPE_API_PORT=18080
BEAMPIPE_METRICS_PORT=9090
BEAMPIPE_JWT_SECRET=replace-with-at-least-32-random-characters
BEAMPIPE_CONFIG=

# Optional Redis-backed rate limiting. Set trusted proxy CIDRs only for networks
# that terminate traffic for the API; untrusted X-Forwarded-For is ignored.
BEAMPIPE_REDIS_URL=
BEAMPIPE_REQUIRE_RATE_LIMITER=false
BEAMPIPE_RATE_LIMIT_REQUESTS=10
BEAMPIPE_RATE_LIMIT_PERIOD_SECONDS=3600
BEAMPIPE_TRUSTED_PROXY_CIDRS=

BEAMPIPE_USE_REAL_BACKENDS=false
BEAMPIPE_CASDA_TAP_URL=https://casda.csiro.au/casda_vo_tools/tap/sync
BEAMPIPE_VIZIER_TAP_URL=https://tapvizier.cds.unistra.fr/TAPVizieR/tap/sync
BEAMPIPE_TM_URL=http://127.0.0.1:9000
BEAMPIPE_DIM_URL=http://127.0.0.1:8001

BEAMPIPE_WORKER_POOL=default
BEAMPIPE_WORKER_CONCURRENCY=4
BEAMPIPE_WORKER_SCHEDULER_ENABLED=false
BEAMPIPE_WORKER_LOCK_SECONDS=600

BEAMPIPE_SSH_CREDENTIALS_HOST=./credentials/ssh
BEAMPIPE_SSH_CREDENTIALS_DIR=
BEAMPIPE_SLURM_SSH_STRICT_KNOWN_HOSTS=true
BEAMPIPE_ASKAPSOFT_SIF=

BEAMPIPE_PROMETHEUS_PORT=9099
BEAMPIPE_PROMETHEUS_RETENTION=30d
BEAMPIPE_ALERTMANAGER_PORT=9094
BEAMPIPE_GRAFANA_PORT=3000
BEAMPIPE_GRAFANA_ADMIN_USER=admin
# Generated by `beampipe setup`; set explicitly when running Compose manually.
BEAMPIPE_GRAFANA_ADMIN_PASSWORD=
